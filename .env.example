# Көшіріп .env атымен сақтаңыз: cp .env.example .env
DJANGO_SECRET_KEY=өз-құпия-кілтіңізді-осында-жазыңыз
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: алдымен сервер, пайдаланушы және дерекқорды жасаңыз (LAB10.md).
# Таза SQLite үшін DB_ENGINE=sqlite деп өзгертіңіз.
DB_ENGINE=postgresql
DB_NAME=clinic_db
DB_USER=clinic_user
DB_PASSWORD=replace-with-your-own-password
DB_HOST=127.0.0.1
DB_PORT=5432

# 11-ЗС: включите 1 для локальных страниц /lab11/ (LAB11.md).
PERFORMANCE_LAB=0
LAB11_TOOLBAR=1
LAB11_SQL_LOG=0
